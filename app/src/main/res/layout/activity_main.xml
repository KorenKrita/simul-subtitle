<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="32dp">

        <!-- ===== home page: one card (status, the two languages, the start button, the translation service), permissions while missing ===== -->
        <LinearLayout
            android:id="@+id/homePage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- top bar: the name, and settings at the end (magpie's header) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal"
                android:paddingStart="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textColor="@color/text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openSettings"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="设置：字幕大小、颜色、翻译和更多"
                    app:icon="@drawable/ic_settings"
                    app:iconSize="22dp"
                    app:iconTint="@color/text2" />
            </LinearLayout>

            <TextView
                style="@style/RowSub"
                android:paddingHorizontal="4dp"
                android:text="把视频、直播里的日语和英语，实时变成字幕" />

            <!-- status, languages, the one action and the service it translates with -->
            <com.google.android.material.card.MaterialCardView
                style="@style/ListCard"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <View
                            android:id="@+id/statusDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp" />

                        <TextView
                            android:id="@+id/statusTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:textColor="@color/text"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/statusBody"
                        style="@style/RowSub"
                        android:layout_marginTop="4dp"
                        android:paddingStart="16dp" />

                    <!-- what is spoken → what the captions are in -->
                    <LinearLayout
                        android:id="@+id/langBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />

                    <TextView
                        android:id="@+id/langHint"
                        style="@style/RowSub"
                        android:layout_marginTop="6dp"
                        android:paddingHorizontal="4dp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:max="1000"
                        android:visibility="gone"
                        app:indicatorColor="@color/brand"
                        app:trackColor="@color/pill"
                        app:trackCornerRadius="2dp"
                        app:trackThickness="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:minHeight="52dp"
                        android:textColor="@color/on_brand"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconSize="20dp"
                        app:iconTint="@color/on_brand" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/secondary"
                        style="?attr/borderlessButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:visibility="gone" />

                    <!-- the translation service in use; opens 设置 › 翻译 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/line" />

                    <LinearLayout
                        android:id="@+id/serviceRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal"
                        android:paddingTop="8dp">

                        <TextView
                            android:id="@+id/serviceText"
                            style="@style/RowSub"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:paddingStart="4dp" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/muted" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- permissions: shown on the home page only while a required one is missing -->
            <LinearLayout
                android:id="@+id/permCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionTitle"
                    android:text="开始前，需要你允许下面两件事" />

                <com.google.android.material.card.MaterialCardView style="@style/ListCard">

                    <LinearLayout
                        android:id="@+id/permList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView
                style="@style/RowSub"
                android:layout_marginTop="16dp"
                android:paddingHorizontal="8dp"
                android:text="声音只在手机上识别，不会上传；翻译时只把识别出的文字发给你填的 LLM API。" />
        </LinearLayout>

        <!-- ===== settings page: magpie's preferences — a category switch at the top, one list per category ===== -->
        <LinearLayout
            android:id="@+id/settingsPage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- back on the left, the title centred on the page (not between back and the edge) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/closeSettings"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="-8dp"
                    android:minWidth="0dp"
                    android:minHeight="48dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="10dp"
                    android:text="返回"
                    android:textColor="@color/text2"
                    android:textSize="15sp"
                    app:icon="@drawable/ic_chevron_left"
                    app:iconPadding="2dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/text2" />

                <!-- side margins clear the back button, so a long sub-page title never runs under it -->
                <TextView
                    android:id="@+id/settingsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="72dp"
                    android:layout_marginEnd="72dp"
                    android:gravity="center"
                    android:text="设置"
                    android:textColor="@color/text"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- categories; filled in code (same segmented control as the options) -->
            <FrameLayout
                android:id="@+id/tabBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp" />

            <!-- == 字幕 == -->
            <LinearLayout
                android:id="@+id/tabCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionTitle"
                    android:text="外观" />

                <com.google.android.material.card.MaterialCardView style="@style/ListCard">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="8dp">

                        <!-- live preview on a fake video frame -->
                        <FrameLayout
                            android:id="@+id/previewStage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/preview_stage"
                            android:minHeight="120dp">

                            <FrameLayout
                                android:id="@+id/previewHolder"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|center_horizontal"
                                android:layout_marginTop="12dp"
                                android:layout_marginBottom="12dp" />
                        </FrameLayout>

                        <TextView
                            style="@style/SliderLabel"
                            android:layout_marginTop="14dp"
                            android:text="字幕配色" />

                        <!-- More than fits scrolls sideways; the fade on the right says so (hidden at the end) -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp">

                            <HorizontalScrollView
                                android:id="@+id/paletteScroll"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clipToPadding="false"
                                android:scrollbars="none">

                                <LinearLayout
                                    android:id="@+id/paletteRow"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal" />
                            </HorizontalScrollView>

                            <View
                                android:id="@+id/paletteFade"
                                android:layout_width="28dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="end"
                                android:background="@drawable/palette_fade"
                                android:importantForAccessibility="no" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/labelSize"
                            style="@style/SliderLabel"
                            android:layout_marginTop="14dp" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderSize"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="文字大小"
                            android:stepSize="1"
                            android:valueFrom="5"
                            android:valueTo="36" />

                        <TextView
                            android:id="@+id/labelAlpha"
                            style="@style/SliderLabel" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderAlpha"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="背景浓淡"
                            android:stepSize="5"
                            android:valueFrom="0"
                            android:valueTo="100" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/SectionTitle"
                    android:text="显示" />

                <com.google.android.material.card.MaterialCardView style="@style/ListCard">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchJa"
                            style="@style/RowSwitch"
                            android:text="同时显示原文" />

                        <View style="@style/RowDivider" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchStats"
                            style="@style/RowSwitch"
                            android:text="显示识别和翻译用时" />

                        <View style="@style/RowDivider" />

                        <!-- the size page: width, height and how much stays on screen -->
                        <LinearLayout
                            android:id="@+id/openSize"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="56dp"
                            android:orientation="horizontal"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/RowName"
                                    android:text="字幕框大小和保留几句" />

                                <TextView
                                    android:id="@+id/sizeSummary"
                                    style="@style/RowSub" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="8dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_chevron_right" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resetStyle"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="4dp"
                    android:minHeight="48dp"
                    android:text="恢复默认" />
            </LinearLayout>

            <!-- == 字幕 › 字幕框大小和保留几句 (a page of its own) == -->
            <LinearLayout
                android:id="@+id/sizePage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    style="@style/ListCard"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:id="@+id/labelWidth"
                            style="@style/SliderLabel"
                            android:layout_marginTop="14dp" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderWidth"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="字幕宽度"
                            android:stepSize="5"
                            android:valueFrom="40"
                            android:valueTo="100" />

                        <TextView
                            android:id="@+id/labelHeight"
                            style="@style/SliderLabel" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderHeight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="字幕高度"
                            android:stepSize="5"
                            android:valueFrom="0"
                            android:valueTo="40" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/SectionTitle"
                    android:text="保留几句" />

                <com.google.android.material.card.MaterialCardView style="@style/ListCard">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:id="@+id/labelKeepSentences"
                            style="@style/SliderLabel"
                            android:layout_marginTop="14dp" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderKeepSentences"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="屏幕上至少留几句"
                            android:stepSize="1"
                            android:valueFrom="1"
                            android:valueTo="6" />

                        <TextView
                            android:id="@+id/labelKeepChars"
                            style="@style/SliderLabel" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderKeepChars"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="字数上限"
                            android:stepSize="10"
                            android:valueFrom="0"
                            android:valueTo="300" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/keepHint"
                    style="@style/RowSub"
                    android:layout_marginTop="8dp"
                    android:paddingHorizontal="8dp" />
            </LinearLayout>

            <!-- == 翻译 == -->
            <LinearLayout
                android:id="@+id/tabTranslate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- translation, display mode, Jev: groups and lists built in code -->
                <LinearLayout
                    android:id="@+id/translateList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- == 页面 == -->
            <LinearLayout
                android:id="@+id/tabPage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/SectionTitle"
                    android:text="页面颜色" />

                <com.google.android.material.card.MaterialCardView style="@style/ListCard">

                    <LinearLayout
                        android:id="@+id/themeBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp" />
                </com.google.android.material.card.MaterialCardView>

                <!-- optional notification permission (Android 13+); the home permission list hides once the required two are granted -->
                <LinearLayout
                    android:id="@+id/notifSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="通知" />

                    <com.google.android.material.card.MaterialCardView style="@style/ListCard">

                        <LinearLayout
                            android:id="@+id/notifList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <!-- == 记录 == -->
            <LinearLayout
                android:id="@+id/tabRecords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/SectionTitle"
                    android:text="字幕文本" />

                <com.google.android.material.card.MaterialCardView style="@style/ListCard">

                    <LinearLayout
                        android:id="@+id/transcriptList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/SectionTitle"
                    android:text="使用记录" />

                <com.google.android.material.card.MaterialCardView style="@style/ListCard">

                    <LinearLayout
                        android:id="@+id/logList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- == 关于 == -->
            <LinearLayout
                android:id="@+id/tabAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/SectionTitle"
                    android:text="使用说明" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/tips_bg"
                    android:lineSpacingExtra="4dp"
                    android:padding="14dp"
                    android:text="0. 第一次用：在「设置 → 翻译 → LLM API」里填好你自己的 LLM 服务（OpenAI 兼容接口的地址、模型 ID 和 API Key），点「测试连接」。模型要能关闭思考，回复越快越好。\n1. 点首页的「开始字幕」，在弹出的窗口里选你要看的 App（也可以选整个屏幕）。\n2. 字幕会浮在屏幕上：按住拖动可以换位置；点一下字幕，四个角会出现小箭头，拖它可以改大小。\n3. 点一下字幕会出现工具栏：调字号、调背景、切换显示方式、开关原文和用时、锁定，或者停止。锁定后位置和大小都固定，点字幕不再出工具栏，只在右下角出一个开锁按钮，点它就解锁。\n4. 有些 App（比如有版权保护的视频）不允许其他 App 听它的声音，这时不会出字幕。同时有别的 App 在放声音时，它的声音也可能出现在字幕里。\n5. 在「记录」里打开「记录每次使用」后，每次使用会留下一份文字记录（不含声音和 key），可以分享出去，帮助反馈问题。默认不记录。"
                    android:textColor="@color/text2"
                    android:textSize="14sp" />

                <TextView
                    style="@style/SectionTitle"
                    android:text="关于" />

                <com.google.android.material.card.MaterialCardView style="@style/ListCard">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/aboutVersion"
                            style="@style/RowName"
                            android:layout_width="match_parent"
                            android:gravity="center_vertical"
                            android:minHeight="48dp"
                            android:paddingHorizontal="14dp" />

                        <View style="@style/RowDivider" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/autoUpdate"
                            style="@style/RowSwitch"
                            android:text="自动检查更新" />

                        <View style="@style/RowDivider" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:baselineAligned="false"
                            android:padding="10dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/checkUpdate"
                                style="@style/Widget.JpSub.ActionButton"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:text="检查更新" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/openRepo"
                                style="@style/Widget.JpSub.ActionButton"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="GitHub 项目主页" />
                        </LinearLayout>

                        <TextView
                            style="@style/RowSub"
                            android:paddingHorizontal="14dp"
                            android:text="https://github.com/KorenKrita/simul-subtitle"
                            android:textIsSelectable="true" />

                        <TextView
                            style="@style/RowSub"
                            android:paddingHorizontal="14dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="14dp"
                            android:text="语音识别用的是 ReazonSpeech 模型和 Silero VAD（通过 sherpa-onnx 在手机上运行，模型已经装在 App 里）。感谢这些项目。" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
